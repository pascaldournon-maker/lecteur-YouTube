
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vidéo – Modèle atomique</title>
<style>
  body {
    margin: 0;
    padding: 20px;
    background: #f5f5f5;
    font-family: Arial, sans-serif;
  }
  .container {
    max-width: 850px;
    margin: auto;
  }
  #player {
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  #player iframe {
    width: 100%;
    height: 100%;
  }
  p {
    text-align: center;
    color: #333;
  }
</style>
</head>
<body>
<div class="container">
  <div id="player"></div>
  <p>Visionnage de l'extrait : 0:00 à 1:49</p>
</div>

<script>
var player;
var timer;

function onYouTubeIframeAPIReady() {
  player = new YT.Player('player', {
    videoId: '8olA8cobrrw',
    playerVars: {
      playsinline: 1,
      rel: 0,
      controls: 1
    },
    events: {
      onStateChange: onPlayerStateChange
    }
  });
}

function onPlayerStateChange(event) {
  if (event.data === YT.PlayerState.PLAYING) {
    if (timer) clearInterval(timer);

    timer = setInterval(function() {
      if (player.getCurrentTime() >= 109) {
        player.seekTo(0, true);
      }
    }, 200);
  } else {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
  }
}

var tag = document.createElement('script');
tag.src = 'https://www.youtube.com/iframe_api';
document.head.appendChild(tag);
</script>
</body>
</html>
